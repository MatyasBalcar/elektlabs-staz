<Window
    x:Class="Knihovna.Views.AuthorDetailWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:resx="clr-namespace:Knihovna.Properties"
    Title="{x:Static resx:Resources.AuthorDetailTitle}"
    Width="500"
    Height="600"
    Background="#F5F7FA"
    Style="{StaticResource AuthorDetailWindow}"
    WindowStartupLocation="CenterOwner">

    <DockPanel>
        <Border
            Padding="20,15"
            Background="White"
            BorderBrush="#E5E7EB"
            BorderThickness="0,1,0,0"
            DockPanel.Dock="Bottom">
            <Button
                Width="120"
                Height="35"
                HorizontalAlignment="Right"
                Command="{Binding CloseCommand}"
                CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                Content="{x:Static resx:Resources.CloseButton}"
                IsCancel="True"
                Style="{StaticResource DangerButtonOutlineStyle}" />
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20">
                <Border
                    Padding="30"
                    Background="White"
                    CornerRadius="12">
                    <Border.Effect>
                        <DropShadowEffect
                            BlurRadius="15"
                            Opacity="0.05"
                            ShadowDepth="2"
                            Color="Black" />
                    </Border.Effect>

                    <StackPanel>
                        <TextBlock
                            Margin="0,0,0,25"
                            FontSize="32"
                            FontWeight="Bold"
                            Foreground="#111827"
                            Text="{Binding CurrentAuthor.FullName}"
                            TextWrapping="Wrap" />

                        <Border
                            Margin="0,0,0,30"
                            Padding="20"
                            Background="#F9FAFB"
                            BorderBrush="#F3F4F6"
                            BorderThickness="1"
                            CornerRadius="8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,15,0">
                                    <TextBlock
                                        Margin="0,0,0,4"
                                        FontSize="12"
                                        FontWeight="Bold"
                                        Foreground="#9CA3AF"
                                        Text="{x:Static resx:Resources.BirthDateLabel}" />
                                    <TextBlock
                                        FontSize="15"
                                        FontWeight="Medium"
                                        Foreground="#374151"
                                        Text="{Binding CurrentAuthor.DateOfBirth, StringFormat=d}" />
                                </StackPanel>

                                <StackPanel Grid.Column="1">
                                    <TextBlock
                                        Margin="0,0,0,4"
                                        FontSize="12"
                                        FontWeight="Bold"
                                        Foreground="#9CA3AF"
                                        Text="{x:Static resx:Resources.NationalityLabel}" />
                                    <TextBlock
                                        FontSize="15"
                                        FontWeight="Medium"
                                        Foreground="#374151"
                                        Text="{Binding CurrentAuthor.Nationality.Name}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <TextBlock
                            Margin="0,0,0,15"
                            FontSize="13"
                            FontWeight="Bold"
                            Foreground="#9CA3AF"
                            Text="{x:Static resx:Resources.WrittenBooksLabel}" />

                        <ItemsControl ItemsSource="{Binding CurrentAuthor.Books}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel
                                        Margin="0,0,0,10"
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal">
                                        <Ellipse
                                            Width="6"
                                            Height="6"
                                            Margin="0,0,12,0"
                                            VerticalAlignment="Center"
                                            Fill="#3B82F6" />
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontSize="16"
                                            FontWeight="Medium"
                                            Foreground="#4B5563"
                                            Text="{Binding Name}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock
                            FontSize="15"
                            FontStyle="Italic"
                            Foreground="#9CA3AF"
                            Text="{x:Static resx:Resources.NoBooksAssigned}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentAuthor.Books.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding CurrentAuthor.Books}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>