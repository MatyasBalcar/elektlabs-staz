<Window
    x:Class="Knihovna.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:DotNetKit.Windows.Controls;assembly=DotNetKit.Wpf.AutoCompleteComboBox"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:resx="clr-namespace:Knihovna.Properties"
    xmlns:vm="clr-namespace:Knihovna.ViewModels"
    SnapsToDevicePixels="True"
    Style="{StaticResource MainWindow}"
    UseLayoutRounding="True"
    mc:Ignorable="d">

    <Window.Resources>
        <Storyboard x:Key="ToastAnimation">
            <DoubleAnimation
                Storyboard.TargetName="ToastBorder"
                Storyboard.TargetProperty="Opacity"
                From="0"
                To="1"
                Duration="0:0:0.3" />
            <DoubleAnimation
                BeginTime="0:0:3"
                Storyboard.TargetName="ToastBorder"
                Storyboard.TargetProperty="Opacity"
                From="1"
                To="0"
                Duration="0:0:0.5" />
        </Storyboard>
    </Window.Resources>

    <Grid Margin="10">
        <ContentControl
            Margin="0,0,5,0"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Panel.ZIndex="1"
            Content="{Binding}"
            ContentTemplate="{StaticResource LanguageSelectTemplate}" />

        <TabControl
            Background="Transparent"
            BorderThickness="0">
            <TabItem DataContext="{Binding BooksListVm}" Header="{x:Static resx:Resources.BooksListTab}">
                <DockPanel>
                    <Separator
                        Height="1"
                        Background="Black"
                        DockPanel.Dock="Top"
                        SnapsToDevicePixels="True">
                        <Separator.RenderTransform>
                            <ScaleTransform ScaleY="1.5" />
                        </Separator.RenderTransform>
                    </Separator>

                    <Grid Margin="0,0,0,10" DockPanel.Dock="Top">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Margin="0,10,0,0"
                            Style="{StaticResource FilterLabelTextBlockStyle}"
                            Text="{x:Static resx:Resources.SearchLabel}" />

                        <StackPanel
                            Grid.Row="1"
                            Grid.Column="0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center">
                            <TextBox
                                Style="{StaticResource SearchBox}"
                                Tag="{x:Static resx:Resources.SearchBookPlaceholder}"
                                Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <Button
                            Grid.Row="1"
                            Grid.Column="2"
                            Width="100"
                            Height="25"
                            VerticalAlignment="Center"
                            Command="{Binding OpenFormCommand}"
                            Content="{x:Static resx:Resources.NewBookButton}"
                            Style="{StaticResource SuccessButtonStyle}" />

                        <StackPanel
                            Grid.Row="2"
                            Grid.Column="0"
                            Grid.ColumnSpan="3"
                            Margin="0,15,0,5"
                            HorizontalAlignment="Left"
                            Orientation="Horizontal">

                            <StackPanel Margin="0,0,5,0">
                                <TextBlock Style="{StaticResource FilterLabelTextBlockStyle}" Text="{x:Static resx:Resources.AuthorLabel}" />
                                <controls:AutoCompleteComboBox
                                    Width="200"
                                    DisplayMemberPath="FullName"
                                    ItemsSource="{Binding AllAuthors}"
                                    SelectedItem="{Binding SelectedAuthor}"
                                    Style="{StaticResource FilterComboBox}"
                                    TextSearch.TextPath="FullName" />
                            </StackPanel>

                            <StackPanel Margin="0,0,5,0">
                                <TextBlock Style="{StaticResource FilterLabelTextBlockStyle}" Text="{x:Static resx:Resources.LanguageLabel}" />
                                <controls:AutoCompleteComboBox
                                    Width="200"
                                    DisplayMemberPath="Name"
                                    ItemsSource="{Binding AllLanguages}"
                                    SelectedItem="{Binding SelectedLanguage}"
                                    Style="{StaticResource FilterComboBox}"
                                    TextSearch.TextPath="Name" />
                            </StackPanel>

                            <StackPanel Margin="0,0,10,0">
                                <TextBlock Style="{StaticResource FilterLabelTextBlockStyle}" Text="{x:Static resx:Resources.PublisherLabel}" />
                                <controls:AutoCompleteComboBox
                                    Width="200"
                                    DisplayMemberPath="Name"
                                    ItemsSource="{Binding AllPublishers}"
                                    SelectedItem="{Binding SelectedPublisher}"
                                    Style="{StaticResource FilterComboBox}"
                                    TextSearch.TextPath="Name" />
                            </StackPanel>

                            <Button
                                Width="75"
                                Height="30"
                                Margin="0,5,0,0"
                                VerticalAlignment="Bottom"
                                Command="{Binding ClearFiltersCommand}"
                                Content="{x:Static resx:Resources.ClearFiltersButton}"
                                Style="{StaticResource FilterButtonStyle}" />
                        </StackPanel>
                    </Grid>

                    <Grid>
                        <DataGrid x:Name="BooksGrid" ItemsSource="{Binding Books}">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Width="200" Header="{x:Static resx:Resources.TitleHeader}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button
                                                Command="{Binding DataContext.OpenDetailCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Content="{Binding Name}"
                                                Style="{StaticResource LinkButtonStyle}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Width="*" Header="{x:Static resx:Resources.AuthorsHeader}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ItemsControl FontWeight="Bold" ItemsSource="{Binding Authors}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Margin="10">
                                                            <Run Text="{Binding FirstName}" />
                                                            <Run Text="{Binding LastName}" />
                                                        </TextBlock>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Width="80" Header="{x:Static resx:Resources.ReadHeader}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Grid
                                                Width="22"
                                                Height="22"
                                                Margin="5,0"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center">

                                                <Path
                                                    x:Name="UnreadBookIcon"
                                                    Margin="1"
                                                    Data="{StaticResource BookIconGeometry}"
                                                    Fill="Black"
                                                    Stretch="Uniform" />

                                                <CheckBox
                                                    x:Name="ReadCheckBox"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Cursor="Hand"
                                                    IsChecked="{Binding HaveRead}"
                                                    Style="{StaticResource IsReadCheckBox}" />
                                            </Grid>

                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding HaveRead}" Value="True">
                                                    <Setter TargetName="UnreadBookIcon" Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Width="Auto" Header="{x:Static resx:Resources.RatingHeader}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel
                                                Margin="5,0"
                                                HorizontalAlignment="Center"
                                                Orientation="Horizontal">
                                                <ContentControl ContentTemplate="{StaticResource StarIconTemplate}" Foreground="{Binding Rating, Converter={StaticResource RatingToColorConverter}, ConverterParameter=1}" />
                                                <ContentControl ContentTemplate="{StaticResource StarIconTemplate}" Foreground="{Binding Rating, Converter={StaticResource RatingToColorConverter}, ConverterParameter=2}" />
                                                <ContentControl ContentTemplate="{StaticResource StarIconTemplate}" Foreground="{Binding Rating, Converter={StaticResource RatingToColorConverter}, ConverterParameter=3}" />
                                                <ContentControl ContentTemplate="{StaticResource StarIconTemplate}" Foreground="{Binding Rating, Converter={StaticResource RatingToColorConverter}, ConverterParameter=4}" />
                                                <ContentControl ContentTemplate="{StaticResource StarIconTemplate}" Foreground="{Binding Rating, Converter={StaticResource RatingToColorConverter}, ConverterParameter=5}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Width="160" Header="{x:Static resx:Resources.ActionHeader}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <StaticResource ResourceKey="ActionColumnTemplate" />
                                    </DataGridTemplateColumn.CellTemplate>

                                    <DataGridTemplateColumn.HeaderStyle>
                                        <Style BasedOn="{StaticResource CustomHeaderStyle}" TargetType="DataGridColumnHeader">
                                            <Setter Property="BorderThickness" Value="0,0,0,1" />
                                        </Style>
                                    </DataGridTemplateColumn.HeaderStyle>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <TextBlock
                            Margin="0,40,0,0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="16"
                            FontStyle="Italic"
                            Foreground="#A0A0A0"
                            IsHitTestVisible="False"
                            Text="{x:Static resx:Resources.NoBooksFound}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Items.Count, ElementName=BooksGrid}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </DockPanel>
            </TabItem>

            <TabItem DataContext="{Binding AuthorsListVm}" Header="{x:Static resx:Resources.AuthorsListTab}">
                <DockPanel>
                    <Separator
                        Height="1"
                        Background="Black"
                        DockPanel.Dock="Top"
                        SnapsToDevicePixels="True">
                        <Separator.RenderTransform>
                            <ScaleTransform ScaleY="1.5" />
                        </Separator.RenderTransform>
                    </Separator>

                    <Grid Margin="0,0,0,10" DockPanel.Dock="Top">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Margin="0,10,0,0"
                            VerticalAlignment="Center"
                            Style="{StaticResource FilterLabelTextBlockStyle}"
                            Text="{x:Static resx:Resources.SearchLabel}" />

                        <TextBox
                            Grid.Row="1"
                            Grid.Column="0"
                            Margin="0,0,0,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Style="{StaticResource SearchBox}"
                            Tag="{x:Static resx:Resources.SearchAuthorPlaceholder}"
                            Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />

                        <Button
                            Grid.Row="1"
                            Grid.Column="2"
                            Width="100"
                            Height="25"
                            VerticalAlignment="Center"
                            Command="{Binding OpenFormCommand}"
                            Content="{x:Static resx:Resources.NewAuthorButton}"
                            Style="{StaticResource SuccessButtonStyle}" />

                        <StackPanel
                            Grid.Row="2"
                            Grid.Column="0"
                            Grid.ColumnSpan="3"
                            Margin="0,15,0,5"
                            HorizontalAlignment="Left"
                            Orientation="Horizontal">

                            <StackPanel Margin="0,0,10,0">
                                <TextBlock Style="{StaticResource FilterLabelTextBlockStyle}" Text="{x:Static resx:Resources.NationalityLabel}" />
                                <controls:AutoCompleteComboBox
                                    Width="150"
                                    DisplayMemberPath="Name"
                                    ItemsSource="{Binding AllNationalities}"
                                    SelectedItem="{Binding SelectedNationality}"
                                    Style="{StaticResource FilterComboBox}"
                                    TextSearch.TextPath="Name" />
                            </StackPanel>

                            <Button
                                Width="75"
                                Height="30"
                                Margin="0,5,0,0"
                                VerticalAlignment="Bottom"
                                Command="{Binding ClearFiltersCommand}"
                                Content="{x:Static resx:Resources.ClearFiltersButton}"
                                Style="{StaticResource FilterButtonStyle}" />
                        </StackPanel>
                    </Grid>

                    <Grid>
                        <DataGrid x:Name="AuthorsGrid" ItemsSource="{Binding Authors}">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Width="150" Header="{x:Static resx:Resources.NameHeader}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button
                                                Command="{Binding DataContext.OpenDetailCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}"
                                                Content="{Binding FullName}"
                                                Style="{StaticResource LinkButtonStyle}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Width="*" Header="{x:Static resx:Resources.NationalityHeader}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock
                                                Margin="10"
                                                FontWeight="Bold"
                                                Text="{Binding Nationality.Name}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>


                                <DataGridTemplateColumn Width="160" Header="{x:Static resx:Resources.ActionHeader}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <StaticResource ResourceKey="ActionColumnTemplate" />
                                    </DataGridTemplateColumn.CellTemplate>

                                    <DataGridTemplateColumn.HeaderStyle>
                                        <Style BasedOn="{StaticResource CustomHeaderStyle}" TargetType="DataGridColumnHeader">
                                            <Setter Property="BorderThickness" Value="0,0,0,1" />
                                        </Style>
                                    </DataGridTemplateColumn.HeaderStyle>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <TextBlock
                            Margin="0,40,0,0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="16"
                            FontStyle="Italic"
                            Foreground="#A0A0A0"
                            IsHitTestVisible="False"
                            Text="{x:Static resx:Resources.NoAuthorsFound}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Items.Count, ElementName=AuthorsGrid}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </DockPanel>
            </TabItem>
        </TabControl>

        <Border
            x:Name="ToastBorder"
            Margin="0,0,0,20"
            Padding="20,10"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Background="#333333"
            CornerRadius="8"
            IsHitTestVisible="False"
            Opacity="0">
            <TextBlock
                x:Name="ToastText"
                FontSize="14"
                FontWeight="SemiBold"
                Foreground="White"
                Text="{x:Static resx:Resources.SuccessToast}" />
        </Border>
    </Grid>
</Window>