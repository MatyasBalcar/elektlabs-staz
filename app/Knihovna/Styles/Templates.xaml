<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:resx="clr-namespace:Knihovna.Properties">
    <DataTemplate x:Key="ActionColumnTemplate">
        <StackPanel
            Margin="0"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Orientation="Horizontal">
            <Button
                Width="70"
                Height="26"
                Margin="4,2"
                Command="{Binding DataContext.OpenFormCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                CommandParameter="{Binding}"
                Content="{x:Static resx:Resources.Edit}"
                Style="{StaticResource PrimaryButtonStyle}" />
            <Button
                Width="70"
                Height="26"
                Margin="4,2"
                Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                CommandParameter="{Binding}"
                Content="{x:Static resx:Resources.Delete}"
                Style="{StaticResource DangerButtonStyle}" />
        </StackPanel>
    </DataTemplate>
</ResourceDictionary>